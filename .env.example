VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# AI Reading Companion (Groq + Gemini) — these are NOT VITE_ vars and must never be added here as
# real values or anywhere else client-side. They're Edge Function secrets only, set with:
#   supabase secrets set GROQ_API_KEY=your-groq-key GEMINI_API_KEY=your-gemini-key
# then deployed with: supabase functions deploy ai-tutor
# See supabase/functions/ai-tutor/index.ts.

# Error reporting (Sentry). Leave empty to keep it off. Public value: a DSN only allows sending
# reports, not reading them. Set it in Vercel → Project → Settings → Environment Variables.
VITE_SENTRY_DSN=

# Page-view analytics (SimpleAnalytics). The one production hostname to count, without https://,
# for example darkworld.dev. Leave empty to keep analytics off.
VITE_ANALYTICS_HOSTNAME=

# Paid plans (Paystack). Server-side secrets only, never VITE_ vars. See docs/billing-setup.md:
#   supabase secrets set PAYSTACK_SECRET_KEY=... PAYSTACK_PLAN_PRO_MONTHLY=PLN_... PAYSTACK_PLAN_MAX_MONTHLY=PLN_... BILLING_ALLOWED_ORIGINS=https://www.darkworldacademy.tech

# Paid plans launch switch. Leave unset (or anything but "on") and DarkWorld is entirely free: every
# lesson and lab is open and stays in the bundle, and Pricing/Billing are hidden. Set to "on" in Vercel
# only after Paystack is live and `npm run publish:paid-content` has run. See docs/billing-setup.md.
VITE_PAID_PLANS=

# Device access. Leave unset (or anything but "on") and phones, tablets and computers can all use
# DarkWorld. Set to "on" to limit it to laptops and desktops again: phones and tablets then see a
# "Continue on a computer" notice (src/components/layout/ComputerAccessGate.tsx).
VITE_COMPUTER_ONLY=

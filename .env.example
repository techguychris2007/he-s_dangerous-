VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# AI Reading Companion (Groq + Gemini) — these are NOT VITE_ vars and must never be added here as
# real values or anywhere else client-side. They're Edge Function secrets only, set with:
#   supabase secrets set GROQ_API_KEY=your-groq-key GEMINI_API_KEY=your-gemini-key
# then deployed with: supabase functions deploy ai-tutor
# See supabase/functions/ai-tutor/index.ts.
